{
  "name": "@dougoos/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "debug": "tsx src/debug.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src --max-warnings 0",
    "smoke:providers": "tsx src/provider-smoke.ts",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dougoos/acp": "workspace:*",
    "@dougoos/providers": "workspace:*",
    "@dougoos/shared": "workspace:*",
    "@dougoos/storage": "workspace:*",
    "@hono/node-server": "2.0.11",
    "hono": "4.12.31"
  }
}
