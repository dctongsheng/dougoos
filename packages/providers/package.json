{
  "name": "@dougoos/providers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "debug": "tsx src/debug.ts",
    "discover": "tsx src/cli-discovery-cli.ts",
    "doctor": "tsx src/doctor-cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.61.0",
    "@agentclientprotocol/codex-acp": "1.1.7",
    "@dougoos/acp": "workspace:*",
    "@dougoos/shared": "workspace:*",
    "pi-acp": "0.0.31"
  }
}
