{
  "name": "@dougoos/cloud",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build && pnpm run build:worker && node ../../tooling/assert-cloud-release.mjs",
    "build:worker": "wrangler deploy --dry-run --outdir dist/worker",
    "dev": "vite",
    "dev:worker": "wrangler dev --local",
    "debug": "tsx src/debug.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "types:worker": "wrangler types worker-configuration.d.ts"
  },
  "dependencies": {
    "@dougoos/shared": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260724.1",
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  }
}
